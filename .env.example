# העתיקי את הקובץ הזה ל-.env ומלאי את המפתחות האמיתיים

# בחירת מודל: openai או gemini
LLM_PROVIDER=openai
# המודל של הסוכן (מחוון, בדיקה, בדיקה עצמית)
LLM_MODEL=gpt-6.2-sol
# המודל של השופט בהערכה ב-LangSmith (LLM-as-judge)
JUDGE_MODEL=gpt-6-luna
# חלק מהמודלים תומכים רק ב-1. במודל שתומך אפשר 0 לציונים עקביים יותר
LLM_TEMPERATURE=1

OPENAI_API_KEY=
# GOOGLE_API_KEY=   (רק אם LLM_PROVIDER=gemini)

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=grading-agent
